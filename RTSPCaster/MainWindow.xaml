<Window x:Class="RTSPCaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RTSPCaster"
        xmlns:vm="clr-namespace:RTSPCaster.ViewModels"
        mc:Ignorable="d"
        Title="RTSP Caster" Height="1080" Width="1920">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.CopyLogsCommand}" Executed="CopyLogs_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:MainWindow.CopyLogsCommand}" Gesture="Ctrl+C" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Content="파일 추가" 
                                Grid.Row="0" 
                                Command="{Binding AddFileCommand}" 
                                Padding="8,2" 
                                Margin="6,6,6,6"
                                />
                        <Button Content="VLC 경로 등록" 
                                Grid.Row="1" 
                                Command="{Binding RegisterVlcPlayerPathCommand}" 
                                ToolTip="VLC 실행 파일(vlc.exe) 경로를 등록합니다." 
                                Padding="8,2" 
                                Margin="6,6,6,6"
                                />
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="MediaMTX" Margin="0,0,8,0" Padding="6,4,6,6" Grid.Row="0" Grid.ColumnSpan="2">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center" ItemHeight="28">
                                    <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding MediaMtxHost}" Width="110" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding MediaMtxPort}" Width="60" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <Button Content="연결 확인" Command="{Binding CheckMediaMtxCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding MediaMtxStatus}" Margin="0,4,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>



                        <Button Content="전체 시작" Grid.Row="1" Grid.Column="0" Command="{Binding StartAllCommand}" Padding="8,8" Margin="6,6,6,6"/>
                        <Button Content="전체 중지" Grid.Row="1" Grid.Column="1" Command="{Binding StopAllCommand}" Padding="8,8" Margin="6,6,6,6"/>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="RTSP URL" Margin="0,0,8,0" Padding="6,4,6,6" Grid.Row="0">
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <WrapPanel VerticalAlignment="Center" ItemHeight="28">
                                    <TextBlock Text="템플릿:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding BulkRtspTemplate}" Width="300"
                                        ToolTip="rtsp://{host}:{port}/stream_{index} 형태. {host},{port},{index},{index:D3},{name} 지원" 
                                        Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                    <Button Content="Help" Command="{Binding ShowRtspTemplateHelpCommand}"
                                        ToolTip="RTSP 템플릿 사용법 보기" Margin="0,0,4,0" Padding="6,2"/>
                                    <Button Content="전체 적용" Command="{Binding ApplyRtspTemplateToAllCommand}"/>
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="자동 재시작" Margin="0,0,8,0" Padding="6,4,6,6" Grid.Row="1">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center" ItemHeight="28">
                                    <CheckBox Content="활성화" IsChecked="{Binding AutoRestartEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="최대 재시도:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding MaxAutoRestartAttempts, UpdateSourceTrigger=LostFocus}" Width="50" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="기본 지연(s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding AutoRestartBaseDelaySeconds, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="리셋 기준(s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding AutoRestartResetThresholdSeconds, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <Button Content="적용" Command="{Binding ApplyRestartPolicyCommand}" Padding="8,2"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    
                </WrapPanel>

                
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding Channels}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="채널" Binding="{Binding Name}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="해상도" Binding="{Binding Resolution}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="코덱(V/A)" Binding="{Binding Codecs}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="호환성" Binding="{Binding CompatibilityText}" Width="200" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="RTSP URL (경로 편집 가능)" Width="380">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RtspUrlPrefix}" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox Text="{Binding RtspPath, UpdateSourceTrigger=LostFocus}"
                                             MinWidth="120" VerticalAlignment="Center"/>
                                    <Button Content="📋" Command="{Binding CopyUrlCommand}"
                                            ToolTip="URL을 클립보드에 복사"
                                            Margin="4,0,0,0" Padding="6,0" VerticalAlignment="Center"/>
                                    <Button Content="VLC" Command="{Binding OpenVlcCommand}"
                                            ToolTip="등록된 VLC 플레이어로 스트림 열기"
                                            Margin="4,0,0,0" Padding="6,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="헬스" Binding="{Binding HealthSummary}" Width="200" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="그래프" Width="130" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Height="20" Width="110" Margin="0,3,0,3" BorderBrush="#33000000" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center">
                                    <Canvas Width="110" Height="20" Background="#05000000">
                                        <Polyline Points="{Binding HealthSparkPoints}" Stroke="#2E7D32" StrokeThickness="1.4"/>
                                    </Canvas>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="변환 진행률" Width="120" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ConversionProgress}" Height="16"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="동작" Width="220" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="시작" Command="{Binding StartCommand}" Margin="2"/>
                                    <Button Content="중지" Command="{Binding StopCommand}" Margin="2"/>
                                    <Button Content="삭제" Command="{Binding RemoveCommand}" Margin="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Gray"/>

            <GroupBox Grid.Row="2" Header="로그">
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Extended">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="복사" Click="CopyLogs_Click" ToolTip="선택 항목 또는 전체 로그를 클립보드로 복사합니다."/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
